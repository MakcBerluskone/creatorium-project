# Адрес API без /api/site. Из него сайт берёт данные в браузере и на сборке.
NUXT_PUBLIC_API_BASE=http://localhost:8010

# Адрес самого сайта: канонические ссылки, og:url, sitemap.xml, robots.txt.
NUXT_PUBLIC_SITE_URL=http://localhost:3001

# Кабинет площадки: «Зарегистрировать площадку» ведёт на /register, «Заказать технику» → /rentals/{id}.
NUXT_PUBLIC_SPACE_CABINET_URL=https://space.creatorium.loc:5177

# Кабинет специалиста: «Забронировать» → /bookings/new/{id}, «Создать карточку» → /register,
# «Заказать технику» → /rentals/{id}.
NUXT_PUBLIC_SPECIALIST_CABINET_URL=https://spec.creatorium.loc:5178

# Кабинет организатора: «Заказать технику» → /rentals/{id}.
NUXT_PUBLIC_ORGANIZER_CABINET_URL=https://org.creatorium.loc:5179
