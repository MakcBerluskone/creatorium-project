# Статическая сборка nuxt generate на Apache (виртуальный хостинг без Node.js).
#
# Что есть в сборке — отдаём как есть: /spaces → spaces/index.html без
# редиректа на слеш. Страницы площадок, специалистов, событий и
# организаторов, которых не было на сборке (одобрили или завели позже),
# открываются через SPA-оболочку 200.html и грузят данные из API в браузере.
# Остальное — честный 404 со страницей 404.html.

Options -Indexes
DirectoryIndex index.html
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Каталог со страницей внутри: /spaces, /spaces/ → spaces/index.html.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # Файл есть — отдаём.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Новых страниц в сборке ещё нет — SPA-оболочка.
  RewriteRule ^(spaces|specialists|events|organizers)/\d+/?$ /200.html [L]
</IfModule>

<IfModule mod_headers.c>
  # В _nuxt имена файлов с хешем: их можно кешировать навсегда.
  <If "%{REQUEST_URI} =~ m#^/_nuxt/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # HTML и payload меняются с каждой пересборкой.
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
